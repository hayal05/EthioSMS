# Copy to .env in the repository root. Never commit real secrets.
NODE_ENV=development
PORT=3000
# Generate a private token with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required in production; readiness is inaccessible if unset in development.
READINESS_TOKEN=
# Private one-time key for creating the first Master Admin through the website.
# Generate a unique value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Add this only to the hosting environment (e.g. Render), never to frontend/VITE variables.
ADMIN_SETUP_KEY=
# Safe defaults. Live mode requires every explicit guard in the Android guide.
SMS_GATEWAY=mock
SMS_ENABLED=false
# Optional for local foundation; required for database readiness and migrations.
# Use the pooled Neon connection URL. Remote TLS certificates are verified.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Keep 0 for direct/local access. Use 1 only behind one trusted reverse proxy
# (e.g. Render) so login limits use the correct client IP.
TRUST_PROXY_HOPS=0

# Required for mock message submission (64 lowercase hex characters).
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Preserve this key securely while encrypted jobs exist; do not put it in VITE_* variables.
PAYLOAD_ENCRYPTION_KEY=

# Live transport remains OFF. Configure only after approving a controlled live test.
LIVE_SMS_APPROVED=false
LIVE_SMS_RECIPIENTS=
SMSGATE_TOKEN=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_DEVICE_ID=
SMSGATE_SIM=1

# Independent random 32-byte secret, hex encoded; required for OTP service.
OTP_SECRET=
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
