# Copy to .env in the repository root. Never commit real secrets.
NODE_ENV=development
PORT=3000
# Generate a private token with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required in production; readiness is inaccessible if unset in development.
READINESS_TOKEN=
# Task 1 deliberately supports mock mode only. Live configuration fails closed.
SMS_GATEWAY=mock
SMS_ENABLED=false
# Database integration arrives in Task 2. Not required for Task 1.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
