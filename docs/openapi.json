  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "EthioSMS API key"
      }
    },
    "schemas": {
      "Receipt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "live"
            ]
          },
          "encoding": {
            "type": "string",
            "enum": [
              "GSM-7",
              "UTF-16"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalSegments": {
            "type": "integer"
          },
          "recipients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "segments": {
                  "type": "integer"
                },
                "status": {
                  "type": "string"
                },
                "errorCode": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "History": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "application_limit": {
            "type": "integer"
          },
          "tenant_limit": {
            "type": "integer"
          },
          "application_reserved": {
            "type": "integer"
          },
          "application_used": {
            "type": "integer"
          },
          "tenant_reserved": {
            "type": "integer"
          },
          "tenant_used": {
            "type": "integer"
          },
          "application_remaining": {
            "type": "integer"
          },
          "tenant_remaining": {
            "type": "integer"
          }
        }
      },
      "Challenge": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "mode": {
            "type": "string"
          }
        }
      },
      "Verification": {
        "type": "object",
        "properties": {
          "verified": {
            "type": "boolean"
          }
        }
      }
    }
  }
