{
  "name": "@ethiosms/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "db:migrate": "node --env-file-if-exists=../.env --import tsx src/db/migrate.ts",
    "admin:bootstrap": "node --env-file-if-exists=../.env --import tsx src/auth/bootstrap.ts bootstrap",
    "admin:recover": "node --env-file-if-exists=../.env --import tsx src/auth/bootstrap.ts recover",
    "db:maintain": "node --env-file-if-exists=../.env --import tsx src/db/maintain.ts",
    "db:verify": "node --env-file-if-exists=../.env --import tsx src/db/verify.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
